# ===== DAYLUXE AI CEO — copy to .env and fill in. Never commit .env =====

# --- Business (verified facts only) ---
BUSINESS_NAME=Dayluxe Roofing & Property Services
BUSINESS_WEBSITE=https://dayluxeroofing.com/
BUSINESS_PHONE=0402 749 443
SERVICE_AREA=Sydney and Western Sydney, NSW, Australia
# Use \n for new lines
EMAIL_SIGNATURE=Azher – Dayluxe Roofing
TIMEZONE=Australia/Sydney

# --- Security (generate with: python -c "import secrets;print(secrets.token_urlsafe(32))") ---
ADMIN_TOKEN=
WEBHOOK_SECRET=

# --- Storage (on Render: point at the persistent disk, e.g. /var/data/dayluxe.db) ---
DATABASE_PATH=data/dayluxe.db

# --- Approval policy (safe defaults — do not change unless you mean it) ---
AUTO_SEND_EMAIL=false
AUTO_PUBLISH_SOCIAL=false
AUTO_SPEND_AD_BUDGET=false
AUTO_SEND_QUOTES=false
CEO_APPROVAL_REQUIRED=true

# --- AI text: auto | openai | gemini | none (none = built-in templates) ---
TEXT_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite

# --- Gmail (OAuth client + refresh token with gmail.readonly + gmail.compose scopes) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_USER=me
GMAIL_QUERY=is:unread in:inbox newer_than:7d
GMAIL_MAX_MESSAGES=20

# --- WordPress (Users → Profile → Application Passwords) ---
WP_BASE_URL=https://dayluxeroofing.com
WP_USERNAME=
WP_APP_PASSWORD=

# --- Meta (Facebook Page / Instagram Business) ---
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
META_GRAPH_VERSION=v25.0

# --- Content ---
GENERATE_IMAGES=false
# Public URL of this app (needed so Facebook/Instagram can fetch generated images)
PUBLIC_BASE_URL=
SEO_TARGET_SUBURBS=Parramatta,Penrith,Blacktown,Liverpool,Campbelltown,Castle Hill,Rouse Hill,Fairfield
POSTS_PER_WEEK=3
FOLLOWUP_AFTER_DAYS=3
PRICING_FILE=config/pricing.json

# --- Runtime ---
HOST=0.0.0.0
PORT=8000
# Minutes between automatic cycles (0 = only when you press "Run cycle now")
RUN_INTERVAL_MINUTES=30
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
LOG_LEVEL=INFO
